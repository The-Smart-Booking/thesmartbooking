POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example

# Migrations e seed: dono das tabelas (superusuário, ignora o RLS). A porta 5467 é
# a do compose.yml. O goose lê estas três variáveis e o .env sozinho: `goose up`.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://example:example@localhost:5467/example?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations

# API: app_user, sem BYPASSRLS (criado na 0.15). Nunca aponte para o usuário acima.
DATABASE_URL=postgres://app_user:app_user@localhost:5467/example?sslmode=disable
