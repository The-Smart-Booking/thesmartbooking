POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example

# usada pelo goose e psql a partir da Fatia 0; a porta 5467 é a exposta no compose.yml.
# Só para migrations: o usuário do POSTGRES_USER é superusuário e ignora o RLS.
# A API conecta como app_user (item 0.15), nunca com esta URL.
DATABASE_URL=postgres://example:example@localhost:5467/example?sslmode=disable
